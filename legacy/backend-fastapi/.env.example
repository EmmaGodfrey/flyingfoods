# Local development environment variables for ERP backend services.
APP_NAME=ERP Core API
APP_ENV=development
APP_DEBUG=true
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-please

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
